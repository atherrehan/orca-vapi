{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "vapi",
  "name": "Vapi Orca",
  "version": "0.1.0",
  "description": "Unofficial, read-only Vapi console for Orca: browse assistants, calls, transcripts, tool calls and costs next to your code. Not affiliated with Vapi.",
  "author": {
    "name": "atherrehan",
    "url": "https://github.com/atherrehan"
  },
  "repository": "https://github.com/atherrehan/orca-vapi",
  "homepage": "https://github.com/atherrehan/orca-vapi",
  "license": "MIT",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Vapi Orca: a read-only Vapi console inside Orca with calls, a tool-call debugger and cost insights"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "vapi",
        "title": "Vapi",
        "icon": "bot",
        "entry": "src/panel/index.html"
      }
    ],
    "commands": [
      { "id": "vapi.refresh", "title": "Vapi: Refresh" },
      { "id": "vapi.disconnect", "title": "Vapi: Disconnect" },
      { "id": "vapi.network", "title": "Vapi: Show network activity" }
    ]
  },
  "capabilities": [
    { "kind": "secrets:own" }
  ]
}
